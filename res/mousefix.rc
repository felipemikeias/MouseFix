#include <windows.h>
#include "resource.h"

IDI_APP     ICON "mousefix.ico"
IDI_PAUSED  ICON "mousefix-paused.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "mousefix.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0"
        BEGIN
            VALUE "CompanyName", "Felipe Mikeias"
            VALUE "FileDescription", "MouseFix - filtro de clique duplo"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "MouseFix"
            VALUE "LegalCopyright", "Copyright (C) 2026 Felipe Mikeias - Licenca MIT"
            VALUE "OriginalFilename", "MouseFix.exe"
            VALUE "ProductName", "MouseFix"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
